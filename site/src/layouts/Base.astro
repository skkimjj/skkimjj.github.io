---
interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  /** 본문 폭을 1040px로 넓힌다. 홈의 2단 배치처럼 720px로는 좁은 화면에만 쓴다.
      머리띠·푸터 안쪽 정렬도 함께 넓어져 본문과 어긋나지 않는다. */
  wide?: boolean;
}
const { title, description, noindex = false, wide = false } = Astro.props;
const home = import.meta.env.BASE_URL;
const site = Astro.site ?? new URL('http://localhost:4321');
const ogImage = new URL(`${home}og-default.png`, site).href;
const canonical = new URL(Astro.url.pathname, site).href;
// Google Analytics 4 측정 ID. 배포 워크플로(deploy-site.yml)에서 PUBLIC_GA4_ID로
// 주입한다. 값이 없으면(로컬 빌드 등) 추적 스크립트를 넣지 않는다.
// noindex 페이지(네이버 복붙용·발행 전 초안)에는 절대 넣지 않는다 —
// 네이버로 복사되는 HTML에 추적 코드가 섞이면 안 되기 때문.
const gaId = import.meta.env.PUBLIC_GA4_ID;
const enableAnalytics = !noindex && !!gaId;
// 애드센스 게시자 ID(ca-pub-...). 배포 워크플로에서 PUBLIC_ADSENSE_ID로 주입한다.
// 값이 없으면 광고 스크립트를 넣지 않는다(로컬 빌드·승인 전).
// GA4와 같은 이유로 noindex 페이지(네이버 복붙용·발행 전 초안)에는 넣지 않는다 —
// 네이버로 복사되는 HTML에 광고 스크립트가 섞이면 안 된다.
const adsenseId = import.meta.env.PUBLIC_ADSENSE_ID;
const enableAds = !noindex && !!adsenseId;

// 헤더 장 상태 표시용 휴장일. 원본은 비공개 레포 data/krx-holidays.json이고,
// 매년 갱신할 때 site/src/data/market-holidays.json도 함께 고쳐야 한다.
import holidays from '../data/market-holidays.json';

// 현재 위치 표시(aria-current). 브리핑 개별 글도 '오늘 브리핑' 탭으로 묶는다.
const path = Astro.url.pathname;
const section = path.startsWith(`${home}learn`)
  ? 'learn'
  : path.startsWith(`${home}about`)
    ? 'about'
    : path.startsWith(`${home}contact`)
      ? 'contact'
      : 'briefing';
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="google-site-verification"
      content="esZkEQ6blxan9Ku46Le4lU3UylTTfA1wNADedJYYK08"
    />
    {/* 네이버 소유확인 태그 2개 — 위: 옛 주소(skkimjj.github.io), 아래: gaejang.com(2026-08-04 전환).
        서치어드바이저는 사이트(주소)별로 다른 토큰을 발급하므로 둘 다 남긴다. 옛 주소 속성을
        정리하기 전에 위 태그를 지우면 그쪽 소유확인이 풀린다. */}
    <meta
      name="naver-site-verification"
      content="6369cfcf77519190937260a204c3581aeef2e051"
    />
    <meta
      name="naver-site-verification"
      content="5f95529cbf9290a31078ee93298faaa94508213c"
    />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {!noindex && <link rel="canonical" href={canonical} />}
    <link
      rel="alternate"
      type="application/rss+xml"
      title="개장 전 브리핑"
      href={`${home}rss.xml`}
    />
    <meta property="og:type" content="article" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="개장 전 브리핑" />
    <meta name="twitter:card" content="summary_large_image" />
    {/* svg만 선언하면 크롬이 /favicon.ico를 별도로 가져가 그쪽을 쓴다. 실제로
        옛 마크가 탭에 남는 원인이었다(2026-08-04). ico를 명시적으로 선언하고
        파일도 같은 마크로 맞춰 둔다. */}
    <link rel="icon" type="image/svg+xml" href={`${home}favicon.svg`} />
    <link rel="icon" type="image/x-icon" sizes="48x48" href={`${home}favicon.ico`} />
    <link rel="apple-touch-icon" href={`${home}apple-touch-icon.png`} />
    {
      enableAds && (
        <script
          async
          src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adsenseId}`}
          crossorigin="anonymous"
        />
      )
    }
    {
      enableAnalytics && (
        <script define:vars={{ gaId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() {
            dataLayer.push(arguments);
          }
          gtag('js', new Date());
          gtag('config', gaId);
          var s = document.createElement('script');
          s.async = true;
          s.src = 'https://www.googletagmanager.com/gtag/js?id=' + gaId;
          document.head.appendChild(s);
        </script>
      )
    }
  </head>
  <body class={wide ? 'wide' : undefined}>
    <header class="board">
      <div class="board-top">
        <a href={home} class="brand">
          <span class="mark" aria-hidden="true">
            <svg viewBox="0 0 128 128">
              <line
                x1="64"
                y1="16"
                x2="64"
                y2="112"
                stroke="#d64545"
                stroke-width="9"
                stroke-linecap="round"></line>
              <rect x="42" y="40" width="44" height="52" rx="6" fill="#d64545"
              ></rect>
            </svg>
          </span>
          <span class="brand-text">
            <b>개장 전 브리핑</b>
            <span class="tagline">매일 아침, 시장 데이터 팩트 정리</span>
          </span>
        </a>
        {/* 장 상태·시각은 정적 빌드로 알 수 없다. 스크립트가 채우기 전에는
            숨겨 두어 틀린 값이 잠깐 보이는 일을 막는다. */}
        <p class="status" id="market-status" hidden>
          <span class="live"><i aria-hidden="true"></i><span data-state></span></span>
          <span data-clock></span>
        </p>
      </div>
      <nav class="board-nav" aria-label="주요 메뉴">
        <a href={home} aria-current={section === 'briefing' ? 'page' : undefined}>
          오늘 브리핑
        </a>
        <a
          href={`${home}learn/`}
          aria-current={section === 'learn' ? 'page' : undefined}>
          투자 공부방
        </a>
        <a
          href={`${home}about/`}
          aria-current={section === 'about' ? 'page' : undefined}>
          소개
        </a>
        <a
          href={`${home}contact/`}
          aria-current={section === 'contact' ? 'page' : undefined}>
          연락처
        </a>
      </nav>
    </header>
    <script define:vars={{ holidays: holidays.dates }} is:inline>
      (function () {
        var el = document.getElementById('market-status');
        if (!el) return;
        function render() {
          // KST 기준 '지금'. 사용자의 시간대와 무관하게 한국 장을 판정한다.
          var kst = new Date(Date.now() + 9 * 36e5);
          var p = function (n) {
            return String(n).padStart(2, '0');
          };
          var ymd =
            kst.getUTCFullYear() +
            '-' +
            p(kst.getUTCMonth() + 1) +
            '-' +
            p(kst.getUTCDate());
          var dow = kst.getUTCDay();
          var mins = kst.getUTCHours() * 60 + kst.getUTCMinutes();
          var state;
          if (dow === 0 || dow === 6 || holidays.indexOf(ymd) !== -1)
            state = '휴장';
          else if (mins < 9 * 60) state = '개장 전';
          else if (mins < 15 * 60 + 30) state = '장중';
          else state = '장 마감';
          el.querySelector('[data-state]').textContent = state;
          el.querySelector('[data-clock]').textContent =
            ymd.replace(/-/g, '.') +
            ' (' +
            '일월화수목금토'[dow] +
            ') ' +
            p(kst.getUTCHours()) +
            ':' +
            p(kst.getUTCMinutes()) +
            ' KST';
          el.hidden = false;
        }
        render();
        setInterval(render, 30000);
      })();
    </script>
    <main>
      <slot />
    </main>
    {
      /* noindex(네이버 복붙용·발행 전 초안) 페이지에는 사이트 푸터를 넣지 않는다.
         전체선택 복붙 시 소개·개인정보처리방침 링크와 (네이버 본문에 이미 있는)
         면책 문구가 딸려가는 것을 막기 위함. 공개 페이지에만 렌더링. */
      !noindex && (
        <footer class="site-footer">
          <div class="footer-inner">
            <p class="footer-links">
              <a href={`${home}about/`}>소개</a>
              <a href={`${home}contact/`}>연락처</a>
              <a href={`${home}privacy/`}>개인정보처리방침</a>
            </p>
            <p>
              본 사이트의 글은 공개된 시장 데이터를 정리한 정보성 콘텐츠이며,
              특정 종목·상품의 매매 권유가 아닙니다. 모든 투자 판단과 책임은
              투자자 본인에게 있습니다.
            </p>
          </div>
        </footer>
      )
    }
  </body>
</html>

<style is:global>
  :root {
    --text: #1a1d24;
    --muted: #6b7280;
    --line: #e5e7eb;
    --accent: #0f4bd8;
    --bg: #ffffff;
    --bg-soft: #f7f8fa;
    --mark-bg: #ffe89a;
    --strong: #b43c3c;
    /* 시세판(헤더·푸터) — 라이트/다크 양쪽에서 어두운 띠를 유지한다.
       본문 흰 여백과 대비를 만들어 글이 또렷해 보이게 하는 것이 이 디자인의 요지. */
    --board: #141a24;
    --board-fg: #eef1f6;
    --board-muted: #9aa7ba;
    --board-line: #2b3444;
    --signal: #d64545;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --text: #e7eaf1;
      --muted: #98a2b3;
      --line: #2a3140;
      --accent: #7aa5ff;
      --bg: #10141c;
      --bg-soft: #1a2029;
      --mark-bg: #7a641a;
      --strong: #ff8b8b;
      --board: #070a10;
      --board-fg: #e7eaf1;
      --board-muted: #8794a8;
      --board-line: #232b3a;
      --signal: #e05a5a;
    }
  }
  * {
    box-sizing: border-box;
  }
  body {
    margin: 0;
    font-family:
      'Apple SD Gothic Neo', 'Pretendard', 'Noto Sans KR', system-ui,
      sans-serif;
    color: var(--text);
    background: var(--bg);
    line-height: 1.7;
    word-break: keep-all;
  }
  /* ── 시세판 헤더 ───────────────────────────────────────────────
     본문 폭(720px)은 그대로 두고 띠만 화면 전체로 흘린다. 안쪽 정렬은
     .board-top / .board-nav 가 각각 720px로 맞춘다. */
  .board {
    background: var(--board);
    border-bottom: 3px solid var(--signal);
  }
  .board-top,
  .board-nav,
  .footer-inner {
    max-width: 720px;
    margin: 0 auto;
    padding-left: 1.25rem;
    padding-right: 1.25rem;
  }
  /* wide 페이지(홈 2단)에서는 본문·머리띠·푸터를 같은 폭으로 함께 넓힌다.
     한쪽만 넓히면 로고와 본문 왼쪽 끝이 어긋난다. */
  body.wide .board-top,
  body.wide .board-nav,
  body.wide .footer-inner,
  body.wide main {
    max-width: 1040px;
  }
  .board-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1rem;
    flex-wrap: wrap;
    padding-top: 0.9rem;
    padding-bottom: 0.75rem;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    color: var(--board-fg);
  }
  .brand .mark {
    width: 26px;
    height: 26px;
    flex: none;
    border-radius: 22%;
    background: rgba(255, 255, 255, 0.06);
    display: grid;
    place-items: center;
    overflow: hidden;
  }
  .brand .mark svg {
    display: block;
    width: 100%;
    height: 100%;
  }
  .brand b {
    display: block;
    font-size: 1.12rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.25;
  }
  .brand .tagline {
    display: block;
    font-size: 0.72rem;
    color: var(--board-muted);
    line-height: 1.4;
  }
  .status {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    margin: 0;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.72rem;
    color: var(--board-muted);
    font-variant-numeric: tabular-nums;
  }
  .status .live {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    background: rgba(214, 69, 69, 0.16);
    color: #ff9a9a;
    border: 1px solid rgba(214, 69, 69, 0.45);
    border-radius: 4px;
    padding: 0.05rem 0.4rem;
    font-weight: 700;
  }
  .status .live i {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #ff6b6b;
    display: block;
  }
  .board-nav {
    display: flex;
    gap: 0.2rem;
    border-top: 1px solid var(--board-line);
    overflow-x: auto;
    scrollbar-width: none;
  }
  .board-nav::-webkit-scrollbar {
    display: none;
  }
  .board-nav a {
    color: var(--board-muted);
    text-decoration: none;
    font-size: 0.86rem;
    font-weight: 600;
    white-space: nowrap;
    padding: 0.6rem 0.85rem;
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
  }
  .board-nav a:hover {
    color: var(--board-fg);
  }
  .board-nav a[aria-current] {
    color: #fff;
    border-bottom-color: var(--signal);
  }
  .board a:focus-visible,
  .site-footer a:focus-visible {
    outline: 2px solid var(--signal);
    outline-offset: 2px;
    border-radius: 3px;
  }
  main {
    max-width: 720px;
    margin: 0 auto;
    padding: 1.5rem 1.25rem 3rem;
  }
  .site-footer {
    background: var(--board);
    color: var(--board-muted);
    font-size: 0.79rem;
  }
  .footer-inner {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    padding-top: 1.4rem;
    padding-bottom: 2rem;
  }
  .footer-inner p {
    margin: 0;
  }
  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
  }
  .footer-links a {
    color: var(--board-fg);
    text-decoration: none;
    font-weight: 600;
  }
  .footer-links a:hover {
    color: var(--signal);
  }
  a {
    color: var(--accent);
  }
  h1 {
    font-size: 1.55rem;
    line-height: 1.4;
  }
  h2 {
    font-size: 1.2rem;
    margin-top: 2.2rem;
    padding-bottom: 0.4rem;
    border-bottom: 1px solid var(--line);
  }
  table {
    border-collapse: collapse;
    width: 100%;
    margin: 1rem 0;
    font-size: 0.92rem;
  }
  th,
  td {
    border: 1px solid var(--line);
    padding: 0.5rem 0.75rem;
    text-align: left;
  }
  th {
    background: var(--bg-soft);
  }
  img {
    max-width: 100%;
    height: auto;
  }
  blockquote {
    margin: 1rem 0;
    padding: 0.5rem 1rem;
    border-left: 3px solid var(--accent);
    background: var(--bg-soft);
    color: var(--muted);
  }
  /* 핵심 문장·수치 하이라이트 */
  mark {
    background: linear-gradient(transparent 55%, var(--mark-bg) 55%);
    color: inherit;
    padding: 0 0.15em;
    font-weight: 600;
  }
  article strong {
    color: var(--strong);
  }
  /* 공부방 그래프 (라이브러리 없이 HTML+CSS, 다크모드 자동) */
  .chart {
    margin: 1.5rem 0;
    padding: 1.25rem 1rem;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--bg-soft);
  }
  .chart figcaption {
    font-weight: 700;
    font-size: 0.95rem;
    margin-bottom: 1.25rem;
    text-align: center;
  }
  .bars {
    display: flex;
    /* flex-start = 모든 열의 트랙 상단을 맞춘다. 트랙 높이가 고정이므로
       라벨이 몇 줄이든 막대 하단이 한 줄로 정렬된다. */
    align-items: flex-start;
    gap: 0.5rem;
  }
  .bar-col {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .bar-track {
    /* ⚠️ 높이 고정 필수. flex:1로 두면 라벨 줄 수(<br> 유무)에 따라 트랙 높이가
       달라져 막대 하단이 열마다 어긋난다(2026-07-30 사용자 지적).
       라벨이 2줄인 열만 막대가 위로 올라가 보이던 원인. */
    height: 210px;
    display: flex;
    align-items: flex-end;
  }
  .bar {
    position: relative;
    width: 100%;
    border-radius: 4px 4px 0 0;
    background: var(--accent);
    opacity: 0.3;
  }
  .bar-col.hi .bar {
    opacity: 1;
  }
  .bar-val {
    position: absolute;
    bottom: 100%;
    left: 0;
    right: 0;
    text-align: center;
    margin-bottom: 3px;
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--text);
    font-variant-numeric: tabular-nums;
  }
  .bar-label {
    margin-top: 0.4rem;
    text-align: center;
    font-size: 0.7rem;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .bar-col.hi .bar-val {
    color: var(--accent);
  }
  .bar-col.hi .bar-label {
    color: var(--accent);
    font-weight: 700;
  }
  /* 음수(하락) 그래프 — figure에 class="chart down"을 주면 막대가 기준선(0)에서
     아래로 자란다. 수치는 음수인데 막대가 위로 뻗어 상승처럼 읽히는 오해를 막는다.
     (2026-07-26 신설. 네이버용 SVG는 원래 아래로 그려왔으므로 이제 웹/네이버 표현이 일치한다.) */
  .chart.down .bars {
    position: relative;
    border-top: 2px dashed var(--line);
  }
  .chart.down .bars::before {
    /* 기준선 라벨. absolute라 flex 아이템이 되지 않는다(열로 끼어들지 않음). */
    content: '0';
    position: absolute;
    top: -1.2rem;
    right: 0;
    font-size: 0.68rem;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .chart.down .bar-track {
    align-items: flex-start;
  }
  .chart.down .bar {
    border-radius: 0 0 4px 4px;
    background: var(--strong);
  }
  .chart.down .bar-val {
    top: 100%;
    bottom: auto;
    margin-top: 3px;
    margin-bottom: 0;
  }
