---
// 네이버 붙여넣기 호환 변환 — /naver/ 복붙 페이지와 /draft/naver/ 초안 페이지가 공유한다.
// (2026-08-23 분리: 초안 페이지에는 이 처리가 없어 붉은 강조가 통째로 사라지고
//  본문이 커서 서식을 상속해 전부 굵게 붙는 문제가 있었다.)
interface Props {
  selector?: string;
}
const { selector = '.naver-body' } = Astro.props;
---

<script is:inline define:vars={{ selector }}>
  // 네이버 편집기는 CSS class가 아니라 인라인 style만 복붙에 반영한다.
  // ⚠️ 네이버는 붙여넣기 때 <strong>/<b> 같은 의미 태그의 인라인 color를 벗겨낸다
  // (형광펜=background-color는 유지). 그래서 붉은 강조는 <strong>에 색을 주는 대신
  // <strong>을 색 입힌 <span>으로 치환한다 — 스팬의 인라인 color는 편집기가 유지하는 편.
  const body = document.querySelector(selector);
  if (body) {
    body.querySelectorAll('strong, b').forEach((el) => {
      const span = document.createElement('span');
      span.style.color = '#c0392b';
      span.style.fontWeight = '700';
      while (el.firstChild) span.appendChild(el.firstChild);
      el.replaceWith(span);
    });
    body.querySelectorAll('mark').forEach((el) => {
      el.style.backgroundColor = '#fff3a6';
      el.style.color = 'inherit';
    });
    // ⚠️ 굵게가 아닌 부분에도 굵기를 '명시'해 둔다 (2026-08-23).
    // 굵은 부분에만 font-weight:700을 박으면 나머지 텍스트에는 굵기 정보가 없다.
    // 네이버 편집기는 그런 조각을 붙여넣을 때 **커서가 있던 자리의 서식을 상속**시킨다 —
    // 이미 발행된 글을 수정하려고 굵은 줄에 커서를 두고 붙이면 본문 전체가 굵게 들어간다.
    // 블록마다 400을 박아 두면 상속될 여지가 없다. 표 헤더처럼 원래 굵은 블록은 유지.
    body.style.fontWeight = '400';
    body
      .querySelectorAll('p, li, td, th, blockquote, h1, h2, h3, h4, h5, h6, div')
      .forEach((el) => {
        const w = window.getComputedStyle(el).fontWeight;
        el.style.fontWeight = Number(w) >= 600 ? '700' : '400';
      });

    // ── 코드 블록 (2026-11-21, kofia-freesis-api — 여러 줄 파이썬 코드가 든 첫 글) ──
    // 사이트의 코드 상자는 검은 배경 <pre> 하나인데, 네이버 편집기는 붙여 넣을 때 이를
    // 줄마다 문단으로 쪼개고 배경색을 각 줄의 글자 뒤에만 칠한다 → 줄 사이·줄 끝이 흰
    // 줄무늬로 남는다. 그래서 (1) 복붙 본문의 코드는 배경·글자색 없는 일반 글자로 바꾸고,
    // (2) 본문 밖(복사 범위 밖)에 「코드 복사」 버튼을 둬, 네이버 「소스코드」 상자에 코드만
    // 따로 붙여 넣을 수 있게 한다. 웹 본문(/learn/)의 검은 상자는 건드리지 않는다.
    // 위의 강조·굵기 처리와 분리해 두었다 — 여기서 오류가 나도 그쪽은 이미 끝나 있다.
    try {
      const pres = Array.from(body.querySelectorAll('pre'));
      if (pres.length) {
        const bar = document.createElement('div');
        bar.className = 'naver-code-bar';
        bar.setAttribute(
          'style',
          'background:#eef4ff;border:1px solid #c9d8f5;border-radius:8px;padding:0.75rem 1rem;' +
            'font-size:0.85rem;color:#1f3b73;margin:0 0 1.5rem;user-select:none;',
        );
        const msg = document.createElement('p');
        msg.style.margin = '0 0 0.5rem';
        msg.textContent =
          `이 글에는 코드 블록이 ${pres.length}개 있습니다. 본문에는 코드가 배경 없는 일반 글자로 ` +
          '들어갑니다. 코드 상자로 보이게 하려면 그 자리에 네이버 편집기의 「소스코드」를 넣고, ' +
          '아래 버튼으로 복사한 코드를 붙여 넣으세요.';
        bar.appendChild(msg);
        pres.forEach((pre, i) => {
          const text = pre.textContent.replace(/\n+$/, '');
          const lines = text.split('\n').length;
          // (1) 붙여넣기용 본문: 토큰별 색 <span>을 걷어내고 배경 없는 일반 글자로
          const code = document.createElement('code');
          code.textContent = text;
          pre.replaceChildren(code);
          pre.removeAttribute('class');
          pre.setAttribute('style', 'background:transparent;color:#333333;font-weight:400;white-space:pre-wrap;');
          // (2) 코드만 복사하는 버튼
          const label = `코드 ${i + 1} 복사 (${lines}줄)`;
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.textContent = label;
          btn.setAttribute(
            'style',
            'margin:0.25rem 0.5rem 0 0;padding:0.35rem 0.8rem;border:1px solid #9db4e0;border-radius:6px;' +
              'background:#ffffff;color:#1f3b73;cursor:pointer;font-size:0.85rem;',
          );
          btn.addEventListener('click', async () => {
            let ok = false;
            try {
              await navigator.clipboard.writeText(text);
              ok = true;
            } catch (e) {
              // 클립보드 API가 막힌 환경용 대체 경로
              const ta = document.createElement('textarea');
              ta.value = text;
              ta.style.position = 'fixed';
              ta.style.opacity = '0';
              document.body.appendChild(ta);
              ta.select();
              try {
                ok = document.execCommand('copy');
              } catch (e2) {}
              ta.remove();
            }
            btn.textContent = ok ? `코드 ${i + 1} 복사됨 ✓` : '복사 실패 — 코드를 직접 드래그해 주세요';
            setTimeout(() => {
              btn.textContent = label;
            }, 2000);
          });
          bar.appendChild(btn);
        });
        body.parentNode.insertBefore(bar, body);
      }
    } catch (err) {
      console.error('[NaverPasteFix] 코드 블록 처리 실패', err);
    }
  }
</script>
